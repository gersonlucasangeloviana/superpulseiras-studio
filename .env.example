# Variáveis de ambiente do Docker Compose / Dokploy.
# Não faça commit do arquivo .env preenchido.
POSTGRES_USER=studio
POSTGRES_DB=studio
# Use uma senha aleatória hexadecimal para evitar caracteres reservados na URL.
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_ALEATORIA
STUDIO_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_DA_EQUIPE
SESSION_SECRET=SUBSTITUA_POR_64_CARACTERES_ALEATORIOS
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
APP_ORIGIN=https://studio.seudominio.com.br
COOKIE_SECURE=true
